DATABASE_URL=              # Neon connection string (pooled)
DIRECT_URL=                # Neon direct connection string (for Prisma migrations)
BLOB_READ_WRITE_TOKEN=     # Vercel Blob

# Optional, only needed for the "Capture from URL" upload path
SCREENSHOTONE_ACCESS_KEY=  # ScreenshotOne access key (dash.screenshotone.com/access)
SCREENSHOTONE_SECRET_KEY=  # ScreenshotOne secret key, used to sign requests
